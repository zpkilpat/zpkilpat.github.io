      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Short term synaptic depression improves information transfer in perceptual multistability</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Zachary P. Kilpatrick</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Competitive neural networks are often used to model the dynamics of perceptual bistability.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>binocular rivalry</rdf:li>
               <rdf:li>neural field</rdf:li>
               <rdf:li>ring model</rdf:li>
               <rdf:li>bump attractor</rdf:li>
               <rdf:li>short term depression</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
